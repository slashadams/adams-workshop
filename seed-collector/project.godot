; Engine configuration file.
; Seed Collector — A relaxing seed-collecting and crossbreeding game

[application]
config/name="Seed Collector"
config/description="Explore, collect seeds, and cultivate your garden."
config/version="0.1.0"
config/icon="icon.png"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=480
window/size/mode=0
window/size/always_on_top=false
window/dpi/allow_hidpi=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2=false
textures/vram_compression/import_etc=false
textures/vram_compression/import_s3tc=true

[input]
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false), Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false), Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"position":Vector2(0, 0),"pressed":false,"canceled":false,"double_tap":false,"index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false), Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false)]
}

[autoload]
SeedManager="*res://scripts/seed_manager.gd"