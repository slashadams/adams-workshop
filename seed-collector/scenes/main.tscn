[gd_scene load_steps=4 format=3]

[ext_resource type="AudioStream" path="res://assets/sounds/menu.wav" id="1_menu"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Control

@onready var btn_new_game = $VBoxContainer/NewGameButton
@onready var btn_quit = $VBoxContainer/QuitButton
@onready var menu_sound = $MenuSound

func _ready() -> void:
	btn_new_game.pressed.connect(_on_new_game)
	btn_quit.pressed.connect(_on_quit)

func _on_new_game() -> void:
	if menu_sound:
		menu_sound.play()
	get_tree().change_scene_to_file(\"res://scenes/garden.tscn\")

func _on_quit() -> void:
	if menu_sound:
		menu_sound.play()
	get_tree().quit()
"

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_main")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.18, 0.28, 0.22, 1.0)

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -160.0
offset_top = 100.0
offset_right = 160.0
offset_bottom = 150.0
grow_horizontal = 2
add_theme_font_size_override("font_size", 32)
text = "Seed Collector"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -200.0
offset_top = 155.0
offset_right = 200.0
offset_bottom = 185.0
grow_horizontal = 2
text = "Explore, Collect, & Cultivate"
horizontal_alignment = 1

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -80.0
offset_top = 20.0
offset_right = 80.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="NewGameButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "New Game"

[node name="QuitButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "Quit"

[node name="MenuSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("1_menu")
